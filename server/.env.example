# =================================================================
# Chalcedony Adventures - Backend Environment Template (.env.example)
# Duplicate this file as .env and fill in your values
# =================================================================

# Server Port
PORT=5000

# Environment Mode: development | production
NODE_ENV=development

# MongoDB Connection String
# For Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/chalcedony

# For MongoDB Atlas (Cloud hosted):
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/chalcedony?retryWrites=true&w=majority

# JWT Authentication Secret Key (generate a strong random string in production)
JWT_SECRET=chalcedony_super_secure_jwt_secret_key_2026_xyz987
JWT_EXPIRES_IN=7d

# Default Initial Admin Credentials (auto-seeded on first run)
DEFAULT_ADMIN_EMAIL=admin@chalcedony.com
DEFAULT_ADMIN_PASSWORD=chalcedony2026
DEFAULT_ADMIN_NAME=Chalcedony Administrator
DEFAULT_ADMIN_ROLE=superadmin

# Allowed CORS Origins
CORS_ORIGIN=*

# Image Upload Limit (bytes, default 10MB)
MAX_FILE_SIZE=10485760
